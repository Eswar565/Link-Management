# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Replace YOUR_PASSWORD with your local password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/link-management

# ─── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# ─── Default Admin Account ─────────────────────────────────────────────────────
# Seeded automatically on first boot if no admin exists.
# Change these before deploying to production!
ADMIN_EMAIL=admin@linkvault.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin
